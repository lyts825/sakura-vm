    },
    {
      "start": 69,
      "end": 69,
      "old": [],
      "replacement": [
        "  let hostClosed = false;",
        "  let spawnFailed = false;",
        "  let pendingOutcome: CommandOutcome | undefined;"
      ]
    },
    {
      "start": 91,
      "end": 91,
      "old": [],
      "replacement": [
        "    // Sending a kill is not confirmation that the native owner or its Job closed.",
        "    if (!hostClosed) { pendingOutcome = outcome; return; }"
      ]
    },
    {
      "start": 97,
      "end": 98,
      "old": ["      const finalOutcome = outputForwarder.failed"],
      "replacement": [
        "      // A normal terminal frame follows Job.finish()/wait_empty(). Killing the",
        "      // host only requests kill-on-close; without that receipt descendants have",
        "      // no verified retirement, even when the host's own close was observed.",
        "      const unconfirmed = executionSent && !spawnFailed &&",
        "        (!exitOutcome || exitOutcome.kind === \"crashed\");",
        "      const finalOutcome = unconfirmed",
        "        ? { kind: \"crashed\" as const, errorCode: \"NATIVE_HOST_CLEANUP_UNCONFIRMED\" }",
        "        : outputForwarder.failed"
      ]
    },
    {
      "start": 178,
      "end": 179,
      "old": [
        "  host.once(\"error\", (error) => complete({ kind: \"spawn-failed\", errorCode: (error as NodeJS.ErrnoException).code ?? \"HOST_SPAWN_FAILED\" }));"
      ],
      "replacement": [
        "  host.on(\"error\", (error) => {",
        "    if (host.pid === undefined) {",
        "      spawnFailed = true;",
        "      complete({ kind: \"spawn-failed\", errorCode: (error as NodeJS.ErrnoException).code ?? \"HOST_SPAWN_FAILED\" });",
        "    } else {",
        "      protocolError = String(error);",
        "    }",
        "  });"
      ]
    },
    {
      "start": 184,
      "end": 184,
      "old": [],
      "replacement": ["    hostClosed = true;"]
    },
    {
      "start": 185,
      "end": 186,
      "old": [
        "    if (protocolError) complete({ kind: \"crashed\", errorCode: \"NATIVE_HOST_PROTOCOL_FAILED\" });"
      ],
      "replacement": [
        "    if (pendingOutcome) complete(pendingOutcome);",
        "    else if (protocolError) complete({ kind: \"crashed\", errorCode: \"NATIVE_HOST_PROTOCOL_FAILED\" });"
      ]
    },
    {
      "start": 213,
      "end": 214,
      "old": ["    catch (error) { host.kill(); throw error; }"],
      "replacement": ["    catch (error) { protocolError = String(error); host.kill(); }"]
    }
  ]
