{
  "name": "sakura-vm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A WSL-inspired local Linux workspace, powered by PosixLoom and QEMU",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx server/index.ts --dev",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build && vite build --ssr server/index.ts --outDir .sakura-server && node scripts/prepare-server-assets.mjs",
    "start": "node .sakura-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "verify:vm": "npm run test:vm && npm run test:sandbox && npm run test:engineering && npm run test:integration",
    "test:production": "node scripts/smoke-production.mjs",
    "test:vm": "tsx scripts/smoke-vm.ts",
    "test:sandbox": "tsx scripts/smoke-sandbox.ts",
    "test:features": "tsx scripts/smoke-features.ts",
    "test:engineering": "tsx scripts/smoke-engineering.ts",
    "test:storage": "tsx scripts/smoke-storage.ts",
    "test:storage-pools": "tsx scripts/smoke-storage-pools.ts",
    "test:disaster-recovery": "tsx scripts/smoke-disaster-recovery.ts",
    "test:object-backup": "tsx scripts/smoke-object-backup.ts",
    "test:wireguard": "tsx scripts/smoke-wireguard.ts",
    "test:golden-images": "tsx scripts/smoke-golden-images.ts",
    "test:signed-bundles": "tsx scripts/smoke-signed-bundles.ts",
    "test:hardware-matrix": "tsx scripts/smoke-hardware-matrix.ts",
    "test:cpu-hotplug": "tsx scripts/smoke-cpu-hotplug.ts",
    "test:arm64": "tsx scripts/smoke-arm64.ts",
    "test:process-interop": "tsx scripts/smoke-process-interop.ts",
    "test:ssh-agent-forward": "tsx scripts/smoke-ssh-agent-forward.ts",
    "test:nested-virtualization": "tsx scripts/smoke-nested-virtualization.ts",
    "test:guest-dns": "tsx scripts/smoke-guest-dns.ts",
    "test:acme": "tsx scripts/smoke-acme.ts",
    "test:notebook": "tsx scripts/smoke-notebook.ts",
    "test:browser-ide": "tsx scripts/smoke-browser-ide.ts",
    "test:private-dns": "tsx scripts/smoke-private-dns.ts",
    "test:image-import": "tsx scripts/smoke-image-import.ts",
    "test:uefi": "tsx scripts/smoke-uefi.ts",
    "test:rescue": "tsx scripts/smoke-rescue.ts",
    "test:snapshot-diff": "tsx scripts/smoke-snapshot-diff.ts",
    "test:online-snapshot": "tsx scripts/smoke-online-snapshot.ts",
    "test:auto-remediation": "tsx scripts/smoke-auto-remediation.ts",
    "test:package-cache": "tsx scripts/smoke-package-cache.ts",
    "test:security-scan": "tsx scripts/smoke-security-scan.ts",
    "test:project-cache": "tsx scripts/smoke-project-cache.ts",
    "test:project-quota": "tsx scripts/smoke-project-quota.ts",
    "test:guest-quota": "tsx scripts/smoke-guest-quota.ts",
    "test:backup-recovery": "tsx scripts/smoke-backup-recovery.ts",
    "test:observability": "tsx scripts/smoke-observability.ts",
    "test:network": "tsx scripts/smoke-network.ts",
    "test:http-ingress": "tsx scripts/smoke-http-ingress.ts",
    "test:management": "tsx scripts/smoke-management.ts",
    "test:access": "tsx scripts/smoke-access.ts",
    "test:browser-extension": "tsx scripts/smoke-browser-extension.ts",
    "test:tray": "tsx scripts/smoke-tray.ts",
    "test:hello": "tsx scripts/smoke-hello.ts",
    "tray": "node scripts/start-tray.mjs",
    "test:shared-terminal": "tsx scripts/smoke-shared-terminal.ts",
    "test:development": "tsx scripts/smoke-development.ts",
    "plugins:check": "tsx scripts/check-plugins.ts && tsx scripts/plugin-schema.ts --check",
    "plugins:schema": "tsx scripts/plugin-schema.ts",
    "plugins:sync": "tsx scripts/sync-plugin-catalog.ts",
    "features:audit": "tsx scripts/audit-features.ts",
    "verify": "npm run plugins:check && npm test && npm run build && npm run dist:check && npm run test:production && npm run test:e2e",
    "dist:check": "node scripts/check-distribution.mjs",
    "release:prepare": "node scripts/package-release.mjs",
    "sakura": "node scripts/cli.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "graphql": "16.14.2",
    "selfsigned": "^5.5.0",
    "ssh2": "^1.17.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@novnc/novnc": "1.7.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/novnc__novnc": "1.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "axe-core": "4.13.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.577.0",
    "prettier": "^3.9.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
