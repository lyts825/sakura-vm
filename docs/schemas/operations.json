  "metrics.sample": {
    "id": "sample",
    "method": "GET",
    "path": "/api/vms/:vmId/metrics",
    "status": 200,
    "request": null,
    "response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cpuPercent": {
          "type": "number"
        },
        "memoryUsed": {
          "type": "number"
        },
        "memoryTotal": {
          "type": "number"
        },
        "diskUsed": {
          "type": "number"
        },
        "diskTotal": {
          "type": "number"
        },
        "uptime": {
          "type": "number"
        },
        "sampledAt": {
          "type": "string"
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "memory": {
                "type": "number"
              }
            },
            "required": [
