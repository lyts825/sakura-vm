  "sandbox.list": {
    "id": "list",
    "method": "GET",
    "path": "/api/sandboxes",
    "status": 200,
    "request": null,
    "response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sandboxes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "sandbox": {
                "type": "object",
                "properties": {
                  "network": {
                    "type": "string",
                    "enum": [
                      "isolated",
                      "nat"
                    ]
                  },
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "onExpire": {
                    "type": "string",
                    "enum": [
                      "stop",
                      "delete"
                    ]
                  },
                  "storage": {
                    "type": "string",
                    "enum": [
                      "persistent",
                      "discard-on-stop"
                    ]
                  }
                },
                "required": [
                  "network",
                  "expiresAt",
                  "onExpire"
                ],
                "additionalProperties": false
              },
              "expired": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "stopped",
                  "starting",
                  "running",
                  "paused",
                  "stopping",
                  "error"
                ]
              },
              "poweredOn": {
                "type": "boolean"
              },
              "memoryMiB": {
                "type": "number"
              },
              "cpus": {
                "type": "number"
              },
              "diskGiB": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "sandbox",
              "expired",
              "status",
              "poweredOn",
              "memoryMiB",
              "cpus",
              "diskGiB"
            ],
            "additionalProperties": {}
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "running",
                  "done",
                  "error",
                  "cancelled",
                  "interrupted"
                ]
              },
              "log": {
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "execution": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "timeoutSeconds": {
                    "type": "number"
                  },
                  "requestedArtifacts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "artifacts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "bytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "path",
                        "bytes",
                        "sha256"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "exitCode": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "success",
                      "failed",
                      "timeout",
                      "cancelled",
                      "expired",
                      "interrupted"
                    ]
                  },
                  "timings": {
                    "type": "object",
                    "properties": {
                      "bootMs": {
                        "type": "number"
                      },
                      "commandMs": {
                        "type": "number"
                      },
                      "artifactsMs": {
                        "type": "number"
                      },
                      "shutdownMs": {
                        "type": "number"
                      },
                      "totalMs": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "command",
                  "cwd",
                  "timeoutSeconds",
                  "requestedArtifacts",
                  "artifacts",
                  "timings"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "status",
              "log",
              "startedAt"
            ],
            "additionalProperties": {}
          }
        },
        "persistenceError": {
          "type": "string"
        }
      },
      "required": [
        "sandboxes",
        "runs"
      ],
      "additionalProperties": false
    }
  },
