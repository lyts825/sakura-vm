{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "plugin"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "apiVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "category": {
      "type": "string",
      "enum": [
        "foundation",
        "workspace",
        "development",
        "operations",
        "experimental"
      ]
    },
    "experimental": {
      "type": "boolean"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "optional": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      }
    },
    "systemDependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "activateMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 180000
        },
        "closeMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 180000
        }
      },
      "required": [
        "activateMs",
        "closeMs"
      ],
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "properties": {
        "http": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\/api\\/[a-z][a-z0-9-]*(?:\\/(?:[a-z][a-z0-9-]*|:vmId))*$"
              },
              "methods": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                }
              },
              "projectScoped": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "methods",
              "projectScoped"
            ],
            "additionalProperties": false
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9.-]*$"
              },
              "path": {
                "type": "string",
                "pattern": "^\\/api\\/[a-zA-Z0-9{}:/.-]+$"
              },
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "policy": {
                "type": "object",
                "properties": {
                  "access": {
                    "type": "string",
                    "enum": [
                      "controller",
                      "public",
                      "download-ticket",
                      "extension",
                      "guest",
                      "socket"
                    ]
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "owner",
                        "member",
                        "viewer"
                      ]
                    }
                  },
                  "projectPermission": {
                    "type": "string",
                    "enum": [
                      "read",
                      "write",
                      "execute",
                      "approve"
                    ]
                  },
                  "projectScoped": {
                    "type": "boolean"
                  },
                  "identity": {
                    "type": "string",
                    "enum": [
                      "host",
                      "fixed-vm",
                      "lifecycle"
                    ]
                  },
                  "maintenance": {
                    "type": "string",
                    "enum": [
                      "allow",
                      "block"
                    ]
                  },
                  "transport": {
                    "type": "string",
                    "enum": [
                      "json",
                      "binary",
                      "form",
                      "websocket"
                    ]
                  },
                  "mutating": {
                    "type": "boolean"
                  },
                  "session": {
                    "type": "string",
                    "enum": [
                      "required",
                      "allow-locked"
                    ]
                  },
                  "vmLock": {
                    "type": "string",
                    "enum": [
                      "require-unlocked",
                      "allow-locked"
                    ]
                  },
                  "projectBinding": {
                    "type": "string",
                    "enum": [
                      "none",
                      "query",
                      "input-scope",
                      "legacy-terminal-grant"
                    ]
                  },
                  "approval": {
                    "type": "string",
                    "enum": [
                      "none",
                      "project-change"
                    ]
                  },
                  "extensionAuth": {
                    "type": "string",
                    "enum": [
                      "none",
                      "account",
                      "paired",
                      "preflight"
                    ]
                  },
                  "socketChannel": {
                    "type": "string",
                    "enum": [
                      "events",
                      "terminal",
                      "terminal-view",
                      "logs",
                      "desktop",
                      "desktop-view"
                    ]
                  },
                  "executionOwner": {
                    "type": "string"
                  },
                  "sessionOwner": {
                    "type": "string"
                  }
                },
                "required": [
                  "access",
                  "roles",
                  "projectScoped",
                  "identity",
                  "maintenance",
                  "transport",
                  "mutating",
                  "session",
                  "vmLock",
                  "projectBinding",
                  "approval",
                  "extensionAuth"
                ],
                "additionalProperties": false
              },
              "handler": {
                "type": "string",
                "enum": [
                  "route",
                  "operation"
                ]
              },
              "status": {
                "type": "integer",
                "minimum": 200,
                "maximum": 299
              }
            },
            "required": [
              "id",
              "path",
              "method",
              "policy",
              "handler",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "path": {
                "type": "string",
                "pattern": "^\\/api\\/[a-z][a-z0-9-]*(?:\\/(?:[a-z][a-z0-9-]*|:vmId))*$"
              },
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "status": {
                "type": "integer",
                "minimum": 200,
                "maximum": 299
              }
            },
            "required": [
              "id",
              "path",
              "method",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "sockets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "desktop",
              "terminal-session"
            ]
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "developmentSections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "managed": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "job-retry",
              "jobs",
              "schedule",
              "event",
              "interceptor"
            ]
          }
        }
      },
      "required": [
        "http",
        "routes",
        "operations",
        "sockets",
        "pages",
        "tabs",
        "developmentSections",
        "managed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "description",
    "version",
    "apiVersion",
    "category",
    "experimental",
    "requires",
    "optional",
    "services",
    "systemDependencies",
    "lifecycle",
    "contributes"
  ],
  "additionalProperties": false
}
