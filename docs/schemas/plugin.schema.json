{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "plugin"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "apiVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "category": {
      "type": "string",
      "enum": [
        "foundation",
        "workspace",
        "development",
        "operations",
        "experimental"
      ]
    },
    "experimental": {
      "type": "boolean"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "optional": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "activateMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 180000
        },
        "closeMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 180000
        }
      },
      "required": [
        "activateMs",
        "closeMs"
      ],
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "properties": {
        "http": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\/api\\/[a-z][a-z0-9-]*(?:\\/(?:[a-z][a-z0-9-]*|:vmId))*$"
              },
              "methods": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                }
              },
              "projectScoped": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "methods",
              "projectScoped"
            ],
            "additionalProperties": false
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "path": {
                "type": "string",
                "pattern": "^\\/api\\/[a-z][a-z0-9-]*(?:\\/(?:[a-z][a-z0-9-]*|:vmId))*$"
              },
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "status": {
                "type": "integer",
                "minimum": 200,
                "maximum": 299
              }
            },
            "required": [
              "id",
              "path",
              "method",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "sockets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "desktop",
              "terminal-session"
            ]
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "developmentSections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      },
      "required": [
        "http",
        "operations",
        "sockets",
        "pages",
        "tabs",
        "developmentSections"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "description",
    "version",
    "apiVersion",
    "category",
    "experimental",
    "requires",
    "optional",
    "services",
    "lifecycle",
    "contributes"
  ],
  "additionalProperties": false
}
